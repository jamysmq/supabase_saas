# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-side admin operations
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production URL used in secure account invitation redirects
APP_BASE_URL=https://app.meuassistentevirtual.com.br
TENANT_ACCESS_INVITE_ENABLED=false

# n8n management API, used only from local/admin scripts when needed
N8N_BASE_URL=
N8N_API_KEY=

# WhatsApp Cloud API official Meta provider
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_GRAPH_VERSION=v23.0
WHATSAPP_PUBLIC_PHONE_E164=

# Internal app token used by n8n for WhatsApp sends and background operational monitoring
WHATSAPP_INTERNAL_SEND_TOKEN=

# Meta webhook verification and signature validation
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional forward from the app webhook receiver to the n8n inbound workflow
WHATSAPP_INBOUND_N8N_WEBHOOK_URL=
WHATSAPP_INBOUND_N8N_TOKEN=

# Server-only AES-256-GCM key for tenant payment provider credentials.
# Generate 32 random bytes and encode them as Base64. Never expose as NEXT_PUBLIC_*.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# Mercado Pago OAuth for tenant-owned production accounts.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI=https://supabase-saas-nine.vercel.app/api/payment-providers/mercado-pago/callback
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=https://supabase-saas-nine.vercel.app/api/payment-providers/mercado-pago/webhook

# Server-only official platform billing account. Keep these only in the Vercel environment.
PLATFORM_MERCADO_PAGO_ACCESS_TOKEN=
PLATFORM_MERCADO_PAGO_ACCOUNT_ID=
